{
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "targets": {
        "qa": {
          "functions": ["ecommerce-nadim-qa"]
        },
        "prod": {
          "functions": ["ecommerce-nadim"]
        }
      }
      
    }
  ]
}
